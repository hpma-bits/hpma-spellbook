      "card_level": {
       "type": "integer",
       "enum": [
        1,
        2
       ]
      }
     }
    }
   }
  },
  "affix": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "type",
    "level",
    "name",
    "trigger_type",
    "effects"
   ],
   "properties": {
