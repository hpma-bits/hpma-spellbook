    },
    "weights": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "description": "同序抽取权重（与 entries 等长）"
    },
    "card_attrs": {
     "description": "「按卡牌稀有度×等级」分组标记；通用分组为 null",
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "required": [
