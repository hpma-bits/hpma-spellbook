       },
       "params": {
        "type": "array",
        "description": "extra_params 原值（int/float/嵌套数组混排）"
       }
      }
     }
    }
   }
  },
  "growthLevel": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "level",
